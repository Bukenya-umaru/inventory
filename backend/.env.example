PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/inventory_db
JWT_SECRET=
ENCRYPTION_KEY=
# Comma-separated list of frontend origins allowed by CORS (no trailing slash)
# Full origin only: scheme + domain (+ port if not standard). No paths, no trailing slash.
# Examples: https://yourapp.vercel.app,https://www.yourdomain.com,http://localhost:8080
#
# ALLOWED_ORIGINS      -> used when NODE_ENV=production
# ALLOWED_ORIGINS_DEV  -> used in development (falls back to ALLOWED_ORIGINS if unset)
ALLOWED_ORIGINS=
ALLOWED_ORIGINS_DEV=http://localhost:8080,http://localhost:3000
SEED_DEVELOPER_EMAIL=developer@system.com
SEED_DEVELOPER_PASSWORD=
SEED_ADMIN_EMAIL=john@abcretail.com
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

# App download: place the built APK in backend/downloads (app-release.apk),
# optionally with a release.json describing versionName/versionCode/notes.
# It is served at /downloads/app-release.apk and metadata at /api/app/release.
